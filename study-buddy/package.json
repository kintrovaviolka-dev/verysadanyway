{
  "name": "study-buddy",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "node scripts/extract-catalog.mjs",
    "resus:assets": "python3 scripts/prepare-resus-assets.py",
    "curate": "npm run catalog && node scripts/curate-key-topics.mjs",
    "push-secrets": "node scripts/create-push-secrets.mjs",
    "test": "node --test test/*.test.mjs",
    "dev": "npx wrangler dev",
    "db:local": "npx wrangler d1 migrations apply study-buddy --local",
    "deploy": "npm run catalog && npx wrangler deploy"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
