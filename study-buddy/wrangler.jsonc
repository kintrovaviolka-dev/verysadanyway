{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "study-buddy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-buddy",
      "database_id": "34d92ca5-da63-467b-a2a4-b4b837d626fb"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
