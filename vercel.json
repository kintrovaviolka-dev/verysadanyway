{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/clinical-portal",
      "destination": "/clinical-learning-portal/dist/index.html"
    },
    {
      "source": "/clinical-portal/",
      "destination": "/clinical-learning-portal/dist/index.html"
    },
    {
      "source": "/clinical-portal/:path*",
      "destination": "/clinical-learning-portal/dist/:path*"
    },
    {
      "source": "/upv",
      "destination": "/upv/index.html"
    },
    {
      "source": "/upv/",
      "destination": "/upv/index.html"
    },
    {
      "source": "/upv/:path*",
      "destination": "/upv/:path*"
    },
    {
      "source": "/urgentni-prijem",
      "destination": "/urgentni-prijem/dist/index.html"
    },
    {
      "source": "/urgentni-prijem/",
      "destination": "/urgentni-prijem/dist/index.html"
    },
    {
      "source": "/urgentni-prijem/:path*",
      "destination": "/urgentni-prijem/dist/:path*"
    },
    {
      "source": "/urgentni-prijem-game",
      "destination": "/urgentni-prijem/dist/index.html"
    },
    {
      "source": "/urgentni-prijem-game/",
      "destination": "/urgentni-prijem/dist/index.html"
    },
    {
      "source": "/urgentni-prijem-game/:path*",
      "destination": "/urgentni-prijem/dist/:path*"
    }
  ]
}
