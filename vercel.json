{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/case/(.*)",
      "destination": "/api/case"
    },
    {
      "source": "/api/gemini/(.*)",
      "destination": "/api/gemini"
    },
    {
      "source": "/api/generate-script",
      "destination": "/api/case"
    },
    {
      "source": "/api/generate-audio",
      "destination": "/api/case"
    },
    {
      "source": "/clinical-portal",
      "destination": "/clinical-learning-portal/index.html"
    },
    {
      "source": "/clinical-portal/",
      "destination": "/clinical-learning-portal/index.html"
    },
    {
      "source": "/clinical-portal/index.html",
      "destination": "/clinical-learning-portal/index.html"
    },
    {
      "source": "/clinical-portal/(.*)",
      "destination": "/clinical-learning-portal/$1"
    },
    {
      "source": "/urgentni-prijem-game",
      "destination": "/urgentni-prijem/index.html"
    },
    {
      "source": "/urgentni-prijem-game/",
      "destination": "/urgentni-prijem/index.html"
    },
    {
      "source": "/urgentni-prijem-game/index.html",
      "destination": "/urgentni-prijem/index.html"
    },
    {
      "source": "/urgentni-prijem-game/(.*)",
      "destination": "/urgentni-prijem/$1"
    },
    {
      "source": "/upv",
      "destination": "/upv/index.html"
    },
    {
      "source": "/upv/",
      "destination": "/upv/index.html"
    },
    {
      "source": "/upv/(.*)",
      "destination": "/upv/$1"
    },
    {
      "source": "/drill",
      "destination": "/drill/index.html"
    },
    {
      "source": "/drill/",
      "destination": "/drill/index.html"
    },
    {
      "source": "/drill/(.*)",
      "destination": "/drill/$1"
    },
    {
      "source": "/pwa",
      "destination": "/drill/index.html"
    },
    {
      "source": "/pwa/",
      "destination": "/drill/index.html"
    },
    {
      "source": "/pwa/(.*)",
      "destination": "/drill/$1"
    }
  ]
}
